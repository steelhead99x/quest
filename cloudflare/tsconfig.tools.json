{
	// The tools that run on Bun on a contributor's machine: the device bench and App registration.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["node", "bun"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	},
	"include": [
		"device",
		"scripts",
		"demo/snapshot.ts",
		"demo/build.ts",
		"demo/e2e.ts",
		"demo/a11y.ts",
		"test/*.ts",
		"vitest.config.ts",
		"src/github/app.ts"
	]
}
