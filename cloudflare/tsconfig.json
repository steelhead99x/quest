{
	// The Worker, type-checked against the Workers runtime that `wrangler types` describes.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"types": ["node", "@cloudflare/vitest-plugin/types"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	},
	"include": [
		"src",
		"demo/index.ts",
		"demo/github.ts",
		"demo/snapshot.d.ts",
		"test/worker",
		"worker-configuration.d.ts"
	]
}
